[core]
	autocrlf = false
[init]
	defaultBranch = main
[user]
	name = Guany
	email = hi@guany.me
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIPux/gTjIIzsMoLaGgvd8NBem6r4Sqol48rWU58+NBl6
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[gpg]
	format = ssh
[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
[commit]
	gpgsign = true
[tag]
	gpgSign = true
